# Generated by `aaa mcp init`. An MCP server over stdio: run it with `docker run -i`.
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
RUN useradd --system --uid 10001 --home-dir /app --create-home mcp
WORKDIR /app
COPY requirements.txt .
RUN pip install -r requirements.txt
COPY . .
USER 10001
CMD ["aaa", "mcp", "serve", "--config", "server.toml"]
